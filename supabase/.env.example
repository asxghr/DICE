# =============================================================================
# D.I.C.E. Server-Side Supabase Edge Functions Environment Template
# Location: supabase/.env.example
#
# CRITICAL SECURITY RULES:
# - NEVER expose these server-only secrets to client-side Vite bundles.
# - NEVER prefix these server variables with VITE_.
# - NEVER commit populated values or private keys to source control.
# =============================================================================

# Supabase Project URL (populated automatically by Supabase runtime in production)
SUPABASE_URL=

# Supabase Service Role Key (Server-only administrative key; bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Issuer Ed25519 Private Signing Key (PKCS#8 DER bytes, Base64URL-encoded)
# Used exclusively inside the issue-credential Edge Function for cryptographic signing.
ISSUER_PRIVATE_KEY=

# Allowed Frontend Origin for CORS headers (e.g., https://dice-app.vercel.app)
# If left empty, Edge Functions default strictly to http://localhost:5173 for local dev.
ALLOWED_ORIGIN=
